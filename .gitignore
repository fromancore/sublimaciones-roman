# =============================================
# .gitignore — Sublimaciones Roman
# Gestión de Configuración ISO/IEC/IEEE 12207
# =============================================

# ── Dependencias ──────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ── Outputs de Build ──────────────────────────
dist/
dist-ssr/
build/
out/
*.local

# ── Variables de Entorno (NUNCA versionar) ────
.env
.env.*
!.env.example

# ── Logs ──────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── IDEs y Editores ───────────────────────────
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
.DS_Store
Thumbs.db

# ── Cobertura de Pruebas ──────────────────────
coverage/
.nyc_output/
*.lcov

# ── Cache y Temporales ────────────────────────
.cache/
.parcel-cache/
.turbo/
*.tsbuildinfo
.eslintcache
.stylelintcache
.prettiercache

# ── Vitest ────────────────────────────────────
test-results/
playwright-report/
blob-report/

# ── OS ────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
