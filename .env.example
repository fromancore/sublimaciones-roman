# =============================================
# Variables de Entorno — EJEMPLO PÚBLICO
# =============================================
# IMPORTANTE: Este archivo se versiona en Git.
# NUNCA escribas valores reales aquí.
# Copia este archivo como `.env.local` y
# rellena los valores reales SIN commitear.
#
# Proceso ISO 12207: Gestión de Configuración
# (Sección 6.3.5 — Configuration Item Protection)
# =============================================

# ── Aplicación ────────────────────────────────
# Nombre de la aplicación (visible en SEO/meta tags)
VITE_APP_NAME=Sublimaciones Roman
# Versión de la aplicación (inyectada por CI en builds)
VITE_APP_VERSION=1.0.0
# URL base de la aplicación (sin slash final)
VITE_APP_URL=https://sublimaciones-roman.com

# ── Entorno ───────────────────────────────────
# Valores: development | staging | production
VITE_ENVIRONMENT=development

# ── Servicios Externos ────────────────────────
# Clave pública del gateway de pago (ej. Stripe, MercadoPago)
# Nunca pongas la clave SECRET aquí
VITE_PAYMENT_PUBLIC_KEY=pk_test_XXXXXXXXXXXXXXXX

# ── Analytics ─────────────────────────────────
# Google Analytics ID (opcional)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Mapa / Geolocalización ────────────────────
# API Key de Leaflet/MapTiler (pública)
VITE_MAP_API_KEY=your_map_api_key_here

# ── WhatsApp Business ─────────────────────────
# Número de WhatsApp para contacto (formato internacional sin +)
VITE_WHATSAPP_NUMBER=521234567890
# Mensaje predeterminado de bienvenida
VITE_WHATSAPP_WELCOME_MSG=Hola, me gustaría hacer un pedido

# ── Feature Flags ─────────────────────────────
# Activar/desactivar características en desarrollo
VITE_FEATURE_ADMIN_DASHBOARD=true
VITE_FEATURE_ORDER_TRACKER=true
VITE_FEATURE_PAYMENT_GATEWAY=false
